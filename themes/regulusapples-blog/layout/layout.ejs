<% const pageTitle = page.title ? `${page.title} · ${config.title}` : config.title; %>
<% const analytics = theme.analytics || {}; %>
<% const hasMermaid = String(body || '').includes('data-mermaid-block'); %>
<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#fbfaf4">
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= page.description || config.description %>">
    <link rel="icon" href="<%- url_for('/favicon.svg') %>">
    <link rel="manifest" href="<%- url_for('/manifest.webmanifest') %>">
    <link rel="stylesheet" href="<%- url_for('/css/style.css') %>?v=37">
    <link rel="stylesheet" href="<%- url_for('/css/katex.min.css') %>">
    <script>
      (function () {
        try {
          var savedTheme = localStorage.getItem('regulusapples-blog-theme');
          var preferredTheme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = preferredTheme;
        } catch (error) {}
      }());
    </script>
  </head>
  <body class="page-<%= page.layout || 'default' %>">
    <div class="site-shell">
      <header class="global-bar">
        <div class="global-bar-inner">
          <a class="brand" href="<%- url_for('/') %>" aria-label="回到 RegulusApple's Blog 首页">
            <span class="brand-mark">RA</span>
            <span class="brand-copy"><strong>RegulusApple's Blog</strong><small>Record · Remember · Reinvent</small></span>
          </a>
          <nav class="topnav" aria-label="主导航分组">
            <% (theme.navigation || []).forEach(function (group, index) { %>
              <button type="button" data-nav-group="<%= group.key %>" aria-controls="subnav-<%= group.key %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>"><%= group.label %></button>
            <% }); %>
          </nav>
          <div class="global-actions">
            <button class="search-trigger" id="search-trigger" data-search-trigger type="button" aria-label="打开搜索" aria-haspopup="dialog" aria-controls="search-overlay"><span aria-hidden="true"></span></button>
            <button class="theme-toggle" id="theme-toggle" data-theme-toggle type="button" aria-label="切换颜色模式" aria-pressed="false"><span aria-hidden="true">☼</span><b>浅色</b></button>
            <button class="mobile-menu-trigger" id="mobile-menu-trigger" type="button" aria-label="打开站点导航" aria-controls="mobile-drawer" aria-expanded="false"><span aria-hidden="true"></span></button>
          </div>
        </div>
        <nav class="section-nav" aria-label="当前分组导航">
          <div class="section-nav-inner">
            <% (theme.navigation || []).forEach(function (group, index) { %>
              <div class="subnav-panel" id="subnav-<%= group.key %>" data-subnav-panel="<%= group.key %>"<%= index === 0 ? '' : ' hidden' %>>
                <% (group.items || []).forEach(function (item) { %>
                  <a href="<%- url_for(item.path) %>" data-nav-path="<%= item.path %>"><%= item.label %></a>
                <% }); %>
              </div>
            <% }); %>
          </div>
        </nav>
      </header>

      <div class="mobile-drawer" id="mobile-drawer" hidden>
        <div class="mobile-drawer-backdrop" data-mobile-drawer-close></div>
        <aside class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="mobile-drawer-title" tabindex="-1">
          <div class="mobile-drawer-brand">
            <div class="mobile-drawer-profile">
              <img src="<%- url_for(theme.profile.avatar) %>" alt="">
              <div><strong><%= theme.profile.name %></strong><span><%= theme.profile.role %></span></div>
            </div>
            <button class="mobile-drawer-close" type="button" data-mobile-drawer-close aria-label="关闭侧滑菜单">×</button>
          </div>
          <div class="mobile-drawer-heading">
            <p class="eyebrow">regulusapples-blog / menu</p>
            <div class="mobile-drawer-heading-row">
              <h2 id="mobile-drawer-title">站点导航</h2>
              <% if (page.layout === 'post') { %>
                <button class="mobile-drawer-switch" type="button" data-mobile-drawer-switch aria-controls="mobile-drawer-navigation mobile-drawer-toc">目录 →</button>
              <% } %>
            </div>
          </div>
          <div class="mobile-drawer-tools" aria-label="站点工具">
            <button class="mobile-drawer-tool" type="button" data-search-trigger aria-label="打开搜索"><span aria-hidden="true">⌕</span><b>搜索</b></button>
            <button class="mobile-drawer-tool" type="button" data-theme-toggle aria-label="切换颜色模式" aria-pressed="false"><span aria-hidden="true">☼</span><b>浅色</b></button>
          </div>

          <section class="mobile-drawer-view" id="mobile-drawer-navigation" data-mobile-drawer-view="navigation" aria-label="站点导航">
            <div class="mobile-nav-sections">
              <% (theme.navigation || []).forEach(function (group, index) { %>
                <section class="mobile-nav-section">
                  <h3><span><%= String(index + 1).padStart(2, '0') %></span><%= group.label %></h3>
                  <nav aria-label="<%= group.label %>">
                    <% (group.items || []).forEach(function (item) { %>
                      <a class="mobile-nav-link" href="<%- url_for(item.path) %>" data-nav-path="<%= item.path %>"><span><%= item.label %></span><strong aria-hidden="true">↗</strong></a>
                    <% }); %>
                  </nav>
                </section>
              <% }); %>
            </div>
          </section>

          <% if (page.layout === 'post') { %>
            <section class="mobile-drawer-view" id="mobile-drawer-toc" data-mobile-drawer-view="toc" aria-label="文章目录" hidden>
              <nav id="mobile-article-toc" data-article-toc aria-label="文章目录"><span class="toc-empty">正在生成目录……</span></nav>
            </section>
          <% } %>
        </aside>
      </div>

      <main class="page-content">
        <div class="content-grid<%= page.layout === 'post' ? ' post-content-grid' : '' %>">
          <%- partial('_partial/sidebar') %>
          <section class="main-column">
            <%- body %>
          </section>
          <% if (page.layout === 'post') { %>
            <aside class="article-toc-sidebar" aria-label="文章目录">
              <section class="home-widget home-widget-contents" aria-labelledby="contents-widget-title">
                <div class="home-widget-heading"><h2 id="contents-widget-title">Contents</h2></div>
                <nav id="article-toc" data-article-toc aria-label="文章目录"><span class="toc-empty">滚动查看目录</span></nav>
              </section>
            </aside>
          <% } %>
        </div>
      </main>

      <footer class="site-footer">
        <span>© <%= new Date().getFullYear() %> RegulusApple</span>
        <span>Record · Remember · Reinvent · Revolutionize</span>
        <span>Powered by Hexo</span>
      </footer>

      <div class="search-overlay" id="search-overlay" hidden>
        <div class="search-backdrop" data-search-close></div>
        <section class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="global-search-title">
          <div class="search-dialog-heading">
            <h2 id="global-search-title">Search</h2>
            <button class="search-close" type="button" data-search-close aria-label="关闭搜索">×</button>
          </div>
          <form class="overlay-search-form" action="<%- url_for('/search/') %>" method="get" role="search">
            <label class="sr-only" for="global-search-input">搜索文章</label>
            <input id="global-search-input" type="search" name="q" placeholder="输入关键词搜索" autocomplete="off">
          </form>
        </section>
      </div>
    </div>
    <% if (hasMermaid) { %><script src="<%- url_for('/js/vendor/mermaid.min.js') %>?v=1" defer></script><% } %>
    <script src="<%- url_for('/js/main.js') %>?v=26" defer></script>
    <% if (analytics.enabled && analytics.provider === 'umami' && analytics.script_url && analytics.website_id) { %>
      <script async src="<%= analytics.script_url %>" data-website-id="<%= analytics.website_id %>"></script>
    <% } else if (analytics.enabled && analytics.provider === 'google-analytics' && analytics.measurement_id) { %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= analytics.measurement_id %>"></script>
      <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','<%= analytics.measurement_id %>');</script>
    <% } %>
  </body>
</html>
