<article class="article-page">
  <% const articleText = String(page.content || '').replace(/<[^>]*>/g, ' ').replace(/&[^;]+;/g, ' ').replace(/\s+/g, ' ').trim(); %>
  <% const wordCount = articleText.replace(/\s/g, '').length; %>
  <% const readingMinutes = Math.max(1, Math.ceil(wordCount / 420)); %>
  <div class="article-layout">
    <main class="article-card">
      <header class="article-header">
        <p class="eyebrow">field note / <%= page.date.format('YYYY') %></p>
        <h1><%= page.title %></h1>
        <% if (page.description) { %><p class="article-excerpt"><%= page.description %></p><% } %>
        <div class="tag-list">
          <% if (page.tags) { page.tags.each(function (tag) { %><a href="<%- url_for('/tags/' + tag.name + '/') %>">#<%= tag.name %></a><% }); } %>
        </div>
        <div class="article-stats"><span>发布于 <%= page.date.format('YYYY-MM-DD') %></span><span>阅读约 <%= readingMinutes %> 分钟</span><span>约 <%= wordCount %> 字</span><% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %><span>更新于 <%= page.updated.format('YYYY-MM-DD') %></span><% } %></div>
        <button class="mobile-toc-trigger" type="button" data-mobile-drawer-open="toc" aria-controls="mobile-drawer"><span>打开文章目录</span><strong aria-hidden="true">↗</strong></button>
      </header>
      <% if (page.cover) { %><img class="article-cover" loading="lazy" decoding="async" src="<%- url_for(page.cover) %>" alt="<%= page.title %> 封面"> <% } %>
      <div class="article-body"><%- page.content %></div>
      <% const commentConfig = theme.comments || {}; %>
      <% const commentsEnabled = commentConfig.enabled === true || String(commentConfig.enabled).toLowerCase() === 'true'; %>
      <% const commentsDisabledForPage = page.comments === false || String(page.comments).toLowerCase() === 'false' || page.comment === false || String(page.comment).toLowerCase() === 'false'; %>
      <% const isWeeklyPost = page.weekly === true || String(page.weekly).toLowerCase() === 'true' || page.layout === 'weekly-post'; %>
      <% const commentRepo = commentConfig.repo || ''; %>
      <% const commentRepoId = commentConfig.repoId || commentConfig.repo_id || ''; %>
      <% const commentCategory = commentConfig.category || ''; %>
      <% const commentCategoryId = commentConfig.categoryId || commentConfig.category_id || ''; %>
      <% const fallbackUrl = commentConfig.fallbackUrl || commentConfig.fallback_url || ''; %>
      <% const giscusConfigured = Boolean(commentRepo && commentRepoId && commentCategory && commentCategoryId); %>
      <% if (commentsEnabled && !commentsDisabledForPage && !isWeeklyPost) { %>
        <section class="article-comments" data-comments data-provider="<%= commentConfig.provider || '' %>" data-repo="<%= commentRepo %>" data-repo-id="<%= commentRepoId %>" data-category="<%= commentCategory %>" data-category-id="<%= commentCategoryId %>" data-mapping="<%= commentConfig.mapping || 'pathname' %>" data-reactions-enabled="<%= commentConfig.reactionsEnabled === false || String(commentConfig.reactionsEnabled).toLowerCase() === 'false' ? '0' : '1' %>" data-input-position="<%= commentConfig.inputPosition || commentConfig.input_position || 'bottom' %>" data-lang="<%= commentConfig.lang || 'zh-CN' %>" data-fallback-url="<%= fallbackUrl %>" data-configured="<%= giscusConfigured ? 'true' : 'false' %>">
          <header class="comments-heading">
            <p class="eyebrow">conversation</p>
            <h2>Comments</h2>
            <p>读到这里，也欢迎留下你的想法。</p>
          </header>
          <div class="comments-card">
            <div class="comment-mount" data-comment-mount aria-live="polite">
              <p class="comments-placeholder" data-comments-status><%= giscusConfigured ? '评论区将在滚动到附近时加载。' : '评论功能正在完成 GitHub 配置，暂时可以前往 Discussions 查看。' %></p>
            </div>
            <div class="comments-fallback" data-comments-fallback<%= giscusConfigured ? ' hidden' : '' %>>
              <p>评论暂时无法在这里加载。</p>
              <% if (fallbackUrl) { %><a href="<%= fallbackUrl %>" target="_blank" rel="noopener noreferrer">在 GitHub Discussions 中查看 <span aria-hidden="true">→</span></a><% } %>
            </div>
            <% if (fallbackUrl) { %><noscript><p class="comments-noscript">浏览器需要启用 JavaScript 才能加载评论。<a href="<%= fallbackUrl %>" target="_blank" rel="noopener noreferrer">前往 GitHub Discussions</a></p></noscript><% } %>
          </div>
        </section>
      <% } %>
      <footer class="article-footer"><a href="<%- url_for('/') %>">← 返回全部文章</a><span>Written by <%= config.author || theme.profile.name %></span></footer>
    </main>
  </div>
  <nav class="article-neighbors" aria-label="相邻文章">
    <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><small>上一篇</small><b>← <%= page.prev.title %></b></a><% } else { %><span></span><% } %>
    <% if (page.next) { %><a class="next" href="<%- url_for(page.next.path) %>"><small>下一篇</small><b><%= page.next.title %> →</b></a><% } %>
  </nav>
</article>
