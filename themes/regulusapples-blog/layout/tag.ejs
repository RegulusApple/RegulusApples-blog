<section class="content-section taxonomy-page">
  <div class="section-heading"><div><p class="eyebrow">article / tag</p><h1>#<%= page.tag %><br><em>反复出现的词。</em></h1></div><span><%= page.posts.length %> 篇文章</span></div>
  <div class="post-list">
    <% page.posts.each(function (post, index) { %>
      <article class="post-row" data-post-path="<%= post.path %>"><span class="post-number"><%= String(index + 1).padStart(2, '0') %></span><div class="post-row-main"><%- partial('_partial/post-meta', { post: post }) %><h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3><p><%= post.description || post.excerpt %></p></div><a class="row-arrow" href="<%- url_for(post.path) %>">↗</a></article>
    <% }); %>
  </div>
  <%- partial('_partial/pagination', { page: page }) %>
</section>
