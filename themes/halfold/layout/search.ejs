<section class="content-section search-page" data-search-page data-search-path="<%- url_for('/search.json') %>">
  <div class="section-heading">
    <div><p class="eyebrow">search the notes</p><h1>搜索<br><em>留下的痕迹。</em></h1></div>
    <span><%= site.posts.length %> 篇文章</span>
  </div>

  <form class="search-form" id="search-form" role="search">
    <label class="sr-only" for="search-input">搜索文章</label>
    <input id="search-input" type="search" name="q" placeholder="搜索标题、摘要、正文、标签……" autocomplete="off">
    <button type="submit">开始搜索 <span>↗</span></button>
  </form>
  <p class="search-status" id="search-status" role="status">输入关键词后开始搜索。</p>
  <div class="search-results" id="search-results" aria-live="polite"></div>
</section>
